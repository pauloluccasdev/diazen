# Copie para .env.local. Use a URL e a chave PUBLICÁVEL do projeto.
# Nunca use service_role ou uma chave secreta nestes campos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origem pública do aplicativo, sem caminho. HTTPS em hospedagem.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOMENTE SERVIDOR: necessária para upload, limpeza de fotos e purge da conta.
# Nunca prefixar com NEXT_PUBLIC_ nem incluir valor real no Git.
SUPABASE_SECRET_KEY=

# OPCIONAL: ferramenta administrativa auth:configure, usada apenas localmente.
# Não publicar este token de gerenciamento na hospedagem da aplicação.
SUPABASE_ACCESS_TOKEN=

# OPCIONAL — Garmin Personal API, exclusivamente para a conta proprietária.
# Ambas ficam somente no servidor. Nunca use NEXT_PUBLIC_.
GARMIN_PERSONAL_API_KEY=
GARMIN_OWNER_USER_ID=
